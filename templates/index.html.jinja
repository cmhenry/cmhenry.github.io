{% extends "academic.html.jinja" %}
{% block content %}
      <h1 class="visually-hidden">{{ meta.name | title }}</h1>
      <img class="portrait" src="thumbnail2.png" alt="Colin Henry" width="150" height="150">
      <div class="biography" id="status">
        <p>I am a postdoctoral researcher in the <a href="https://www.ipz.uzh.ch/en.html">Department of Political Science</a> at the University of Zürich.</p>
        <p>I study how digital platform architecture shapes political behavior and community dynamics, with a focus on extremism and hate speech.</p>
      </div>
      {# Keep old homepage fragment links useful without lengthening the default bio. #}
      {% for anchor, label, url in [('papers', 'Publications', 'publications.html'), ('projects', 'Projects', 'projects.html'), ('teaching', 'Teaching', 'teaching.html'), ('elsewhere', 'Elsewhere', 'contact.html'), ('contact', 'Contact', 'contact.html')] %}
      <p class="legacy-link" id="{{ anchor }}"><a href="{{ url }}">{{ label }} →</a></p>
      {% endfor %}
      {% for proj in projects %}
      <p class="legacy-link" id="proj-{{ proj.slug }}"><a href="projects.html#proj-{{ proj.slug }}">{{ proj.name }} →</a></p>
      {% endfor %}
{% endblock %}

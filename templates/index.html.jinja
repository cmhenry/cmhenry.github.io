<!DOCTYPE html>
<html lang="en">
<head>
<!--
   ┌─────────────────────────────────────────────────────────────┐
   │  visit /1994.html if you remember the old web.              │
   └─────────────────────────────────────────────────────────────┘
-->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width">
<title>{{ meta.name }} — {{ meta.role }}</title>
<meta name="description" content="{{ meta.affiliation }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="styles/main.css">
</head>

<body>
<article>

  {# ── header: two geometric panels ─────────────────────── #}
  <header>
    <div class="panel panel--one">
      <hr><hr><hr><hr><hr><hr>
      <div></div>
      {% for word in meta.name.split() %}
      <div><h1 id="n{{ loop.index }}">{{ word }}</h1></div>
      {% endfor %}
      <div></div>
      <div></div>
      <div></div>
      <div class="lines" aria-hidden="true"><div></div><div></div><div></div></div>
    </div>

    <div class="panel panel--two">
      <hr><hr><hr><hr><hr><hr>
      {% for r in meta.roles %}
      <div id="role-{{ loop.index }}">{{ r }}</div>
      {% endfor %}
      <div class="tagline">{{ meta.tagline }}</div>
      <div></div>
      <div></div>
      <div class="lines" aria-hidden="true"><div></div><div></div><div></div></div>
    </div>
  </header>

  {# ── content grid ─────────────────────────────────────── #}
  <main id="content">

    <section id="bio">
      <h3><span class="ornament">※</span> hello <span class="ornament">※</span></h3>
      <p class="lede">{{ meta.short_about }}</p>
      <p class="note">Previously a research fellow at the Dynamic Online Networks Lab,
        George Washington University.</p>
    </section>

    <section id="surf" aria-hidden="true">
      <div class="box-box">
        <div class="box">
          <div class="box__face top"></div>
          <div class="box__face left"></div>
          <div class="box__face right"></div>
        </div>
      </div>
    </section>

    <section id="see-also">
      <h3>see also</h3>
      <ul>
        <li><a href="mailto:{{ meta.email }}">{{ meta.email }}</a></li>
        {% for link in links %}
        <li><a href="{{ link.url }}">{{ link.label | lower }}</a></li>
        {% endfor %}
      </ul>
    </section>

    <section id="papers">
      <h3>papers</h3>
      <ul>
        {% for paper in papers_out %}
        <li>
          {% if paper.url %}<a href="{{ paper.url }}">{{ paper.short or paper.title }}</a>
          {% else %}{{ paper.short or paper.title }}{% endif %}
          <span class="mark">[{{ paper.mark or paper.status_label }}]</span>
        </li>
        {% endfor %}
      </ul>
    </section>

    <section id="in-progress">
      <h3>in progress</h3>
      <ul>
        {% for paper in papers_wip %}
        <li>
          {% if paper.url %}<a href="{{ paper.url }}">{{ paper.short or paper.title }}</a>
          {% else %}{{ paper.short or paper.title }}{% endif %}
          <span class="mark">[{{ paper.mark or paper.status_label }}]</span>
        </li>
        {% endfor %}
      </ul>
    </section>

    <section id="projects">
      <div>
        <h3>projects</h3>
        <ul>
          {% for proj in projects %}
          <li>
            {% if proj.links %}<a href="{{ proj.links[0].url }}">{{ proj.short or proj.name }}</a>
            {% else %}{{ proj.short or proj.name }}{% endif %}
            <span class="mark">[{{ proj.status_label }}]</span>
            {% if proj.short_note %}<br><span class="note">{{ proj.short_note }}</span>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
      <div></div>
    </section>

    <section id="also">
      <div>
        <h3>also here</h3>
        <ul>
          {% for item in also %}
          <li><a href="{{ item.url }}">{{ item.label }}</a>{% if item.note %}
            <span class="mark">[{{ item.note }}]</span>{% endif %}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="box-box" aria-hidden="true">
        <div class="box">
          <div class="box__face top"></div>
          <div class="box__face left"></div>
          <div class="box__face right"></div>
        </div>
      </div>
      <div></div>
    </section>

    <section id="colophon">
      <h3>colophon</h3>
      <ul>
        <li>set in space grotesk &amp; inconsolata</li>
        <li>html + css &middot; no javascript &middot; no trackers</li>
        <li><a href="{{ meta.source_url }}">page source</a></li>
        <li>iss. {{ meta.last_build[:4] }} &middot; build {{ meta.last_build }} &middot; vis. {{ meta.visitors }}</li>
      </ul>
    </section>

  </main>
</article>
</body>
</html>
